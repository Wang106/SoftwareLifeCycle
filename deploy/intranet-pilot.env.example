# Copy to a private file and replace every placeholder before starting the pilot.
# Do not commit the filled file. Do not put a real tenant id, client id, or client secret here in git.
# Microsoft Entra ID (Microsoft 365). Issuer shape is fixed; the tenant id is yours.

POSTGRES_DB=software_lifecycle
POSTGRES_USER=slc
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://slc:REPLACE_ME_DB_PASSWORD@postgres:5432/software_lifecycle

INTRANET_PILOT=true
AUTH_MODE=oidc
SEED_ON_STARTUP=false
SEED_ZFI_DEMO=false
READ_ONLY_MODE=false
ADMIN_OPERATOR_ENABLED=false

OIDC_ISSUER_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
OIDC_AUDIENCE=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OIDC_JWKS_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys
OIDC_AUTHORIZATION_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/authorize
OIDC_TOKEN_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/token
OIDC_ALGORITHMS=RS256
OIDC_SCOPE=openid profile email
OIDC_CLIENT_AUTH=none
OIDC_CLIENT_SECRET=
OIDC_EMAIL_DOMAINS=example.invalid
INTRANET_PILOT_BOOTSTRAP_EMAIL=REPLACE_ME@example.invalid

CORS_ORIGINS=https://app.example.invalid
BROWSER_SESSION_MODE=encrypted
BROWSER_SESSION_ORIGIN=https://app.example.invalid
BROWSER_SESSION_KEY=REPLACE_ME_32_BYTE_BASE64URL
BROWSER_OIDC_MODE=code
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
