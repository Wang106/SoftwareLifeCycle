POSTGRES_DB=software_lifecycle
POSTGRES_USER=slc
POSTGRES_PASSWORD=slc_dev_password
DATABASE_URL=postgresql+psycopg://slc:slc_dev_password@postgres:5432/software_lifecycle
CORS_ORIGINS=http://localhost:3000,https://softwarelifecycle.whf969.com
SEED_ON_STARTUP=true
READ_ONLY_MODE=false
AUTH_MODE=disabled
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_LEEWAY_SECONDS=30
OIDC_JWKS_TIMEOUT_SECONDS=5
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Frontend server-only authentication; public environments remain disabled.
BROWSER_SESSION_MODE=disabled
BROWSER_SESSION_ORIGIN=
# Operator-managed base64url-encoded random 32-byte key; never NEXT_PUBLIC or committed.
BROWSER_SESSION_KEY=

# Provider-neutral code flow. Configure only for an approved HTTPS target/provider.
BROWSER_OIDC_MODE=disabled
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_SCOPE=openid
OIDC_CLIENT_AUTH=none
OIDC_CLIENT_SECRET=

# Offline local operator only; enable temporarily on an approved controlled target.
# Never invoked by startup, seed or HTTP. Keep disabled in ordinary deployments.
ADMIN_OPERATOR_ENABLED=false

# Identity status writes are independently disabled; existing grant/registration gates do not enable this route.
# Exact server-only HTTPS bindings; configure only on an approved controlled target.
PRINCIPAL_STATUS_SUBMISSION_MODE=disabled
PRINCIPAL_STATUS_APPROVED_API_BASE_URL=
PRINCIPAL_STATUS_APPROVED_APP_ORIGIN=


# First Snapshot/actual/Batch writes and own-operation audit recovery; independently closed.
FIRST_COMMAND_SUBMISSION_MODE=disabled
FIRST_COMMAND_APPROVED_API_BASE_URL=
FIRST_COMMAND_APPROVED_APP_ORIGIN=


# Separate approval/decision gate; keep disabled until approved target/provider acceptance.
GOVERNANCE_COMMAND_SUBMISSION_MODE=disabled
GOVERNANCE_COMMAND_APPROVED_API_BASE_URL=
GOVERNANCE_COMMAND_APPROVED_APP_ORIGIN=


# Separate delivery/distribution/production authorization gate; no existing command gate enables it.
DISTRIBUTION_COMMAND_SUBMISSION_MODE=disabled
DISTRIBUTION_COMMAND_APPROVED_API_BASE_URL=
DISTRIBUTION_COMMAND_APPROVED_APP_ORIGIN=

# Test Release / Deployment / Changeover; approved bindings required, independently disabled.
PRODUCTION_COMMAND_SUBMISSION_MODE=disabled
PRODUCTION_COMMAND_APPROVED_API_BASE_URL=
PRODUCTION_COMMAND_APPROVED_APP_ORIGIN=
