{
  "$schema": "./frontend/node_modules/wrangler/config-schema.json",
  "name": "softwarelifecycle",
  "main": "frontend/.open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "softwarelifecycle.whf969.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "frontend/.open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "cd frontend && npm ci && npx opennextjs-cloudflare build"
  },
  "observability": {
    "enabled": true
  }
}
