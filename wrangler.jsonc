{
  "$schema": "./frontend/node_modules/wrangler/config-schema.json",
  "name": "software-lifecycle",
  "main": "frontend/.open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "frontend/.open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "cd frontend && npm install && npx opennextjs-cloudflare build"
  },
  "observability": {
    "enabled": true
  }
}
