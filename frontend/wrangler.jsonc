{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "softwarelifecycle",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "API_BASE_URL": "https://softwarelifecycle-api-test.onrender.com"
  },
  "routes": [
    {
      "pattern": "softwarelifecycle.whf969.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "previews": {
    "vars": {
      "API_BASE_URL": "https://softwarelifecycle-api-test.onrender.com"
    }
  }
}
